<!--
  WebRTC Audio Engine installer (WiX v7). Built by scripts\Build-Msi.ps1, which passes:
    ProductVersion  version of the staged driver packages (DriverVer)
    PackageDir      ..\build\package (component\, app\, extension\ from Build-Package.ps1)
    CertFile        the signing certificate (.cer) the custom action trusts on the target PC
    CaDll           SetupActions.dll (installer\SetupActions.cpp)
    IconFile        the app icon (Installed apps)

  The MSI copies the signed driver packages to Program Files\WebrtcAudioEngine\Driver, then the custom
  action installs them (see SetupActions.cpp). Windows installs the settings app from the app package by
  itself a few seconds later. An upgrade removes the old version completely first (afterInstallInitialize),
  so the old version's uninstall can never remove the new drivers.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WebRTC Audio Engine"
           Manufacturer="RadegasTCZ"
           Version="$(var.ProductVersion)"
           UpgradeCode="{C4E50964-EF2C-4432-91BD-0EBDDA46191F}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of WebRTC Audio Engine is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The packages use Class=AudioProcessingObject, which needs Windows 11 (build 22000). -->
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber"
                      Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WINDOWSBUILD &gt;= 22000" Message="WebRTC Audio Engine needs Windows 11." />

    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Echo cancellation, noise suppression, automatic gain and cleanup for your microphone" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WebrtcAudioEngine">
        <Directory Id="DRIVERFOLDER" Name="Driver">
          <Directory Id="COMPONENTDIR" Name="component" />
          <Directory Id="APPDIR" Name="app" />
          <Directory Id="EXTENSIONDIR" Name="extension" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="DriverPackages">
      <Files Directory="COMPONENTDIR" Include="$(var.PackageDir)\component\**" />
      <Files Directory="APPDIR" Include="$(var.PackageDir)\app\**" />
      <Files Directory="EXTENSIONDIR" Include="$(var.PackageDir)\extension\**" />
      <Component Directory="DRIVERFOLDER">
        <File Source="$(var.CertFile)" Name="WebrtcAudioEngine.cer" />
      </Component>
      <!-- Tells the settings app not to add its own "Installed apps" entry (this one removes everything). -->
      <Component Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="SOFTWARE\WebrtcAudioEngineSetup" Name="ProductCode" Value="[ProductCode]"
                       Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="WebRTC Audio Engine">
      <ComponentGroupRef Id="DriverPackages" />
    </Feature>

    <!-- Driver install / uninstall (deferred, as SYSTEM). Each one is the other's rollback. -->
    <Binary Id="SetupActions" SourceFile="$(var.CaDll)" />
    <CustomAction Id="RollbackInstallDrivers" BinaryRef="SetupActions" DllEntry="UninstallDrivers"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="InstallDrivers" BinaryRef="SetupActions" DllEntry="InstallDrivers"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackUninstallDrivers" BinaryRef="SetupActions" DllEntry="InstallDrivers"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="UninstallDrivers" BinaryRef="SetupActions" DllEntry="UninstallDrivers"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- CustomActionData of each deferred action: the Driver folder. -->
    <SetProperty Id="RollbackInstallDrivers" Value="[DRIVERFOLDER]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="InstallDrivers" Value="[DRIVERFOLDER]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="RollbackUninstallDrivers" Value="[DRIVERFOLDER]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="UninstallDrivers" Value="[DRIVERFOLDER]" After="CostFinalize" Sequence="execute" />

    <InstallExecuteSequence>
      <!-- Install / repair: after the files and the registry marker are in place. -->
      <!-- Its rollback (a full driver uninstall) only for a first install: a failed repair must not
           remove a working installation. -->
      <Custom Action="RollbackInstallDrivers" After="WriteRegistryValues" Condition="NOT Installed AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="InstallDrivers" After="RollbackInstallDrivers" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <!-- Uninstall (also of the old version during an upgrade): while the files are still there. -->
      <Custom Action="RollbackUninstallDrivers" Before="UninstallDrivers" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UninstallDrivers" Before="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
