; WebRTC Audio Engine: effect-pack component INF (test-signed experiment).
; Modelled on Windows' voiceclarityep_audio_component.inf (Voice Clarity effect pack).
; NOTE: the effect-pack schema below is undocumented; Microsoft's own INF names it
; "EffectPack_Schema_Internal_V1". Whether Windows accepts a third-party pack is what we test.

[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %ProviderName%
DriverVer   = 11/11/2026,0.11.2.0
CatalogFile = WebrtcAudioEngine.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = WebrtcEngine,NTamd64

[WebrtcEngine.NTamd64]
%Apo.ComponentDesc% = WebrtcEngine_Install, SWC\VEN_WRTC&AUDIO_EFFECTPACK_WEBRTCENGINE

[WebrtcEngine_Install.NTamd64]
DelReg    = WebrtcEngine_DelReg
AddReg    = WebrtcEngine_AddReg
CopyFiles = WebrtcEngine_CopyFiles

[WebrtcEngine_CopyFiles]
WebrtcVoiceApo.dll

[WebrtcEngine_Install.NTamd64.Services]
AddService = ,2    ; no function driver, install a null driver

[WebrtcEngine_DelReg]
; Updates merge registry values, so drop placements from older versions of this package
; (0.2.x registered an endpoint effect, which effect packs ignore). DelReg runs before AddReg.
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_FX_EndpointEffectClsid%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_CompositeFX_EndpointEffectClsid%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_EFX_ProcessingModes_Supported_For_Streaming%

[WebrtcEngine_AddReg]
; APO COM registration (in the package's own registry key, like Voice Clarity)
HKR,Classes\CLSID\%APO_CLSID%,,,%APO_FriendlyName%
HKR,Classes\CLSID\%APO_CLSID%\InProcServer32,,%REG_EXPAND_SZ%,%13%\WebrtcVoiceApo.dll
HKR,Classes\CLSID\%APO_CLSID%\InProcServer32,ThreadingModel,,"Both"

; APO registration
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"FriendlyName",,%APO_FriendlyName%
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"Copyright",,%Copyright%
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MajorVersion",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MinorVersion",%REG_DWORD%,0
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"Flags",%REG_DWORD%,%APO_FLAG_DEFAULT%
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MinInputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MaxInputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MinOutputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MaxOutputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"MaxInstances",%REG_DWORD%,0xffffffff
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"NumAPOInterfaces",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%APO_CLSID%,"APOInterface0",,"{FD7F2B29-24D0-4B5C-B177-592C39F9CA10}"

HKR,,FriendlyName,,%Apo.ComponentDesc%

; Effect pack registration (same keys and schema as Voice Clarity)
HKR,EffectPackRegistration\%EFFECT_PACK_ID%,%PKEY_FX_EffectPackSchema_Version%,,%PKEY_FX_EffectPack_Schema_Internal_V1%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%,%PKEY_ItemNameDisplay%,,%Effect_Pack_FriendlyName%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%,%PKEY_FX_Author%,,%Effect_Pack_Author%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%,%PKEY_FX_VersionMajor%,%REG_DWORD%,0
HKR,EffectPackRegistration\%EFFECT_PACK_ID%,%PKEY_FX_VersionMinor%,%REG_DWORD%,1
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_FX_ApplyToCapture%,%REG_DWORD%,1
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_FX_Enumerator%,%REG_MULTI_SZ%,"*"
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_FX_Association%,%REG_MULTI_SZ%,%KSNODETYPE_MICROPHONE%,%KSNODETYPE_DESKTOP_MICROPHONE%,%KSNODETYPE_PERSONAL_MICROPHONE%,%KSNODETYPE_OMNI_DIRECTIONAL_MICROPHONE%,%KSNODETYPE_MICROPHONE_ARRAY%,%KSNODETYPE_PROCESSING_MICROPHONE_ARRAY%,%KSNODETYPE_HEADSET%,%KSNODETYPE_HFP_SIDEBAND_HEADSET%,%KSNODETYPE_ECHO_CANCELING_SPEAKERPHONE%,%KSNODETYPE_ECHO_SUPPRESSING_SPEAKERPHONE%,%KSNODETYPE_SPEAKERPHONE_NO_ECHO_REDUCTION%
; Mode effect (MFX), like Voice Clarity. Measured on build 26300: a pack's EFX placement is
; ignored (a pack without an MFX falls back to Device Default Effects), and RAW streams skip
; the pack's MFX. Browsers using RAW run their own WebRTC processing. AEC (aux loopback input)
; is only offered to a capture MFX, so this is also where AEC3 will live.
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_FX_ModeEffectClsid%,,%APO_CLSID%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%APO_CLSID%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_SPEECH%,%AUDIO_SIGNALPROCESSINGMODE_RAW%
HKR,EffectPackRegistration\%EFFECT_PACK_ID%\FxProperties,%PKEY_FX_ExcludeForHWIDs%,%REG_MULTI_SZ%,"ROOT\*","*VirtualAudio*","*Virtual_Audio*","*VirtualDevice*"

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
WebrtcVoiceApo.dll = 1

[DestinationDirs]
WebrtcEngine_CopyFiles = 13 ; the package's DriverStore directory

[Strings]
ProviderName             = "RadegasTCZ"
MfgName                  = "RadegasTCZ"
DiskName                 = "WebRTC Audio Engine"
Apo.ComponentDesc        = "WebRTC Audio Engine"
APO_FriendlyName         = "WebRTC Audio Engine APO"
Copyright                = "Copyright (c) RadegasTCZ"
Effect_Pack_FriendlyName = "WebRTC Audio Engine"
Effect_Pack_Author       = "RadegasTCZ"

EFFECT_PACK_ID = "{9879C461-0BA4-4A7B-9F35-3C04EAC1772D}"
APO_CLSID      = "{2BB71AC0-6882-4965-BC38-CA716D62C0E2}"   ; src\Guids.h CLSID_WebrtcAudioEnginePack

APO_FLAG_DEFAULT = 0x0000000e

KSNODETYPE_MICROPHONE                     = "{DFF21BE1-F70F-11D0-B917-00A0C9223196}"
