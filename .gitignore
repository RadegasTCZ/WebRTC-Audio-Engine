# Build output belongs in ..\build (outside the repo); these catch accidental in-tree builds.
/build/
/out/
/package-out/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/

# Visual Studio / VS Code
.vs/
.vscode/
*.user
*.suo

# Binaries and debug symbols
*.dll
*.exe
*.lib
*.pdb
*.obj
*.ilk
*.exp
*.cat

# Logs, backups, certificates (never commit keys)
*.log
*.reg
*.cer
*.pfx
*.p12
*.key
*.pem
*.pvk
*.spc
*.p7b

# Installer output and archives
*.msi
*.wixpdb
*.cab
*.zip

# Diagnostics: recordings hold microphone/speaker audio; dumps and traces may hold anything
*.wav
*.dmp
*.etl
*.map

# Workspace folders that belong next to the clone, never inside it
/upstream/
/logs/
/backups/
